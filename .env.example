# Discord Developer Portal の Bot ページで取得したトークンを設定します。
# このファイルを .env にコピーし、実際のトークンはコミットしないでください。
DISCORD_BOT_TOKEN=

# 操作対象のサーバーIDと、常設ボタンを投稿する専用チャンネルIDです。
DISCORD_GUILD_ID=
DISCORD_SETUP_CHANNEL_ID=

# アーカイブ内のゲーム名の表記揺れ判定に使用します。
GEMINI_API_KEY=
# 未指定時は gemini-3.5-flash-lite を使用します。
GEMINI_MODEL=

# チャンネル管理ログの既定の送信先です。未指定時は常設ボタンのチャンネルを使用します。
DISCORD_CHANNEL_LOG_CHANNEL_ID=
